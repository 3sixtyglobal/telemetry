{
	"name": "@3sixty/telemetry-connector-opentelemetry",
	"version": "0.20.0-next.2",
	"description": "OpenTelemetry connector for pushing telemetry metrics to OTEL-compatible backends.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/3sixtyglobal/telemetry.git",
		"directory": "packages/telemetry-connector-opentelemetry"
	},
	"author": "adrian.sanchez.sequeira@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0",
		"bun": ">=1.4.4"
	},
	"scripts": {
		"clean": "rimraf dist coverage .cache",
		"build": "tstransform",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"test": "vitest --run --config ./vitest.config.ts",
		"test:bun": "bunx --bun vitest --run --config ./vitest.config.ts",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts",
		"test:build": "tstransform -p ./tests/tsconfig.json",
		"validate-locales": "validate-locales",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "pnpm run docs:clean && pnpm run docs:generate",
		"dist": "pnpm run clean && concurrently -g -n build,locales,types,test \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && concurrently -g -n build,locales,types \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@3sixty/context": "next",
		"@3sixty/core": "next",
		"@3sixty/entity-storage-models": "next",
		"@3sixty/logging-models": "next",
		"@3sixty/nameof": "next",
		"@3sixty/telemetry-connector-entity-storage": "0.20.0-next.2",
		"@3sixty/telemetry-models": "0.20.0-next.2",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
		"@opentelemetry/exporter-prometheus": "0.223.0",
		"@opentelemetry/resources": "2.12.0",
		"@opentelemetry/sdk-metrics": "2.12.0"
	},
	"devDependencies": {
		"@3sixty/entity-storage-connector-memory": "next",
		"@3sixty/nameof-transformer": "next",
		"@3sixty/nameof-vitest-plugin": "next",
		"@3sixty/validate-locales": "next",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"concurrently": "10.0.6",
		"dotenv": "18.0.8",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.14.1",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"telemetry",
		"opentelemetry",
		"otel",
		"metrics",
		"grafana",
		"prometheus",
		"connector",
		"adapter",
		"integration"
	],
	"bugs": {
		"url": "git+https://github.com/3sixtyglobal/telemetry/issues"
	},
	"homepage": "https://3sixty.global"
}
